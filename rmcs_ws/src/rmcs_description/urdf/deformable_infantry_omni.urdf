<?xml version="1.0"?>
<robot name="deformable_infantry_omni">

  <!--
    Isaac Sim focused URDF:
      - simplified collisions
      - explicit inertials
      - lift joints rotate wheel modules downward for positive angle
      - lower lift limit is widened to 0.0 for startup stability
  -->

