#!/bin/bash

source /opt/ros/jazzy/setup.bash

: "${RMCS_PATH:=/workspaces/RMCS}"
readonly RMCS_ROS_PREFIX="/opt/ros/jazzy"
readonly RMCS_BUILD_BASE="build"
readonly RMCS_INSTALL_BASE="install"
readonly RMCS_LOG_BASE="log"

if [[ ! -d "${RMCS_PATH}/rmcs_ws" ]]; then
    echo "> ERROR: Workspace not found: ${RMCS_PATH}/rmcs_ws"
    exit 1
fi

cd "${RMCS_PATH}"/rmcs_ws || exit 1

check_default_dir_restorable() {
    local link_name="$1"
    local expected_prefix="$2"

    if [[ ! -L "${link_name}" ]]; then
        return
    fi

    local target
    target="$(readlink "${link_name}")"
    if [[ "${target}" != "${expected_prefix}"-cross-* && "${target}" != */"${expected_prefix}"-cross-* ]]; then
        echo "> ERROR: ${RMCS_PATH}/rmcs_ws/${link_name} is a symlink to ${target}."
        echo "> It is not a build-rmcs-cross default link. Fix it before running build-rmcs."
        exit 1
    fi
}

restore_default_dir() {
    local link_name="$1"

    if [[ ! -L "${link_name}" ]]; then
        return
    fi

    local target
    target="$(readlink "${link_name}")"

    rm "${link_name}" || exit 1
    mkdir -p "${link_name}" || exit 1
    echo "> Restored ${RMCS_PATH}/rmcs_ws/${link_name} from ${target} symlink."
}

check_default_dir_restorable build build
check_default_dir_restorable install install
check_default_dir_restorable log log

restore_default_dir build
restore_default_dir install
restore_default_dir log

[[ -x /opt/cmake/bin/cmake ]] &&
    export PATH="/opt/cmake/bin:$PATH"

find_stale_ros_library_reference() {
    local build_root="$1"
    local link_file
    local ros_lib_path

    [[ -d "${build_root}" ]] || return 1

    while IFS= read -r -d '' link_file; do
        while IFS= read -r ros_lib_path; do
            [[ -n "${ros_lib_path}" ]] || continue

            if [[ ! -e "${ros_lib_path}" ]]; then
                printf '%s\n%s\n' "${link_file}" "${ros_lib_path}"
                return 0
            fi
        done < <(grep -oE "${RMCS_ROS_PREFIX}/lib/[^[:space:]]+" "${link_file}" | sort -u)
    done < <(find "${build_root}" -path '*/link.txt' -type f -print0 2>/dev/null)

    return 1
}

cmake_toolchain_args=()
event_handlers_args=()
colcon_global_args=(
    --log-base "${RMCS_LOG_BASE}"
)
colcon_build_args=(
    --build-base "${RMCS_BUILD_BASE}"
    --install-base "${RMCS_INSTALL_BASE}"
    --symlink-install
    --merge-install
)

if [[ "${RMCS_USE_LLVM}" == "ON" ]]; then
    missing_tools=()
    for tool in clang clang++ llvm-ar llvm-ranlib ld.lld ninja; do
        if ! command -v "${tool}" &>/dev/null; then
            missing_tools+=("${tool}")
        fi
    done

    if ((${#missing_tools[@]} > 0)); then
        echo "> ERROR: LLVM toolchain is required when RMCS_USE_LLVM=ON."
        echo "> Missing tools: ${missing_tools[*]}"
        echo "> Install the missing tools, or set RMCS_USE_LLVM=OFF to build with GCC."
        exit 1
    fi

    echo "> Compiling With LLVM ToolChain"
    export CC=clang
    export CXX=clang++
    cmake_toolchain_args=(
        "-GNinja"
        "-DCMAKE_MESSAGE_LOG_LEVEL=ERROR"
        "-DCMAKE_EXE_LINKER_FLAGS=-fuse-ld=lld"
        "-DCMAKE_SHARED_LINKER_FLAGS=-fuse-ld=lld"
        "-DCMAKE_AR=$(command -v llvm-ar)"
        "-DCMAKE_RANLIB=$(command -v llvm-ranlib)"
    )
    event_handlers_args=(
        --event-handlers console_cohesion+
    )
fi

stale_ros_ref="$(find_stale_ros_library_reference "${RMCS_BUILD_BASE}")"
if [[ -n "${stale_ros_ref}" ]]; then
    IFS=$'\n' read -r stale_link_file stale_library_path <<<"${stale_ros_ref}"
    echo "> Detected stale ROS library reference in ${stale_link_file}"
    echo "> Missing cached library path: ${stale_library_path}"
    echo "> Forcing CMake reconfigure to refresh absolute ROS library paths."
    colcon_build_args+=(
        --cmake-force-configure
    )
fi

colcon_build_args+=(
    "${event_handlers_args[@]}"
)
cmake_args=(
    "${cmake_toolchain_args[@]}"
)

CLICOLOR_FORCE=1 NINJA_STATUS="" \
    colcon "${colcon_global_args[@]}" build "${colcon_build_args[@]}" "$@" --cmake-args "${cmake_args[@]}"
